/*
 * Naya Create right half - standalone ZMK keymap.
 * You can change any of this live in ZMK Studio (https://zmk.studio).
 *
 * Physical layout:
 *   Enter 6 7 8 9 0 - =
 *         Y U I O P [ ]
 *         H J K L ; ' \
 *         N M , . / Shift (7th key)
 *   S1 S2 S3 Space Alt Option Ctrl S4
 *
 * S1 = layer 1 (F-keys/numpad), S4 = layer 2 (system), S2 = Backspace, S3 = Delete.
 * LEDs (hold S4): H toggle, J next effect, K/L hue +/-, ; and ' saturation +/-,
 *                 N/M brightness +/-, , and . speed +/-, / previous effect.
 * Bootloader: hold S4 + tap Enter.   Studio unlock: hold S4 + tap the 7th key of the "N M" row.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &kp RET  &kp N6 &kp N7 &kp N8    &kp N9  &kp N0   &kp MINUS &kp EQUAL
                         &kp Y  &kp U  &kp I     &kp O   &kp P    &kp LBKT  &kp RBKT
                &kp DEL  &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp SQT   &kp BSLH
                &kp BSPC &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT &kp RSHFT
                &mo 1                  &kp SPACE &kp RALT &kp RGUI &kp RCTRL &mo 2
            >;
        };

        numpad {
            display-name = "Numpad";
            bindings = <
                &trans  &kp F6     &kp F7          &kp F8    &kp F9     &kp F10       &kp F11  &kp F12
                        &kp KP_MULTIPLY &kp KP_N7  &kp KP_N8 &kp KP_N9  &kp KP_PLUS   &kp LPAR &kp RPAR
                &trans  &kp KP_DOT &kp KP_N4       &kp KP_N5 &kp KP_N6  &kp KP_MINUS  &trans   &kp TAB
                &trans  &kp COMMA  &kp KP_N1       &kp KP_N2 &kp KP_N3  &kp KP_DIVIDE &trans   &trans
                &trans                             &kp KP_N0 &kp KP_DOT &trans        &trans   &trans
            >;
        };

        system {
            display-name = "System";
            bindings = <
                &bootloader &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR &out OUT_USB &out OUT_BLE
                            &kp C_PREV   &kp C_NEXT   &kp C_VOL_DN &kp C_VOL_UP &kp C_PP   &kp C_MUTE   &none
                &trans      &rgb_ug RGB_TOG &rgb_ug RGB_EFF &rgb_ug RGB_HUI &rgb_ug RGB_HUD &rgb_ug RGB_SAI &rgb_ug RGB_SAD &none
                &trans      &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_SPI &rgb_ug RGB_SPD &rgb_ug RGB_EFR &none &studio_unlock
                &trans                                &trans       &trans       &trans     &trans       &trans
            >;
        };
    };
};
