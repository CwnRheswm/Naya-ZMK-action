/*
 * Naya Create - right half, standalone.
 * Matrix recovered from the original firmware (kscan-gpio-matrix config):
 *   rows (outputs, active high): P1.09 P1.08 P0.08 P0.07 P0.06
 *   cols (inputs, pull-down):    P0.02 P0.03 P1.15 P1.14 P1.13 P1.12 P0.26 P0.27
 *   inputs = cols, outputs = rows  ->  diode-direction "row2col", debounce 5 ms
 */
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        wakeup-source;
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;

        row-gpios
            = <&gpio1 9 GPIO_ACTIVE_HIGH>
            , <&gpio1 8 GPIO_ACTIVE_HIGH>
            , <&gpio0 8 GPIO_ACTIVE_HIGH>
            , <&gpio0 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 6 GPIO_ACTIVE_HIGH>
            ;

        col-gpios
            = <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 26 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 27 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    /*
     * 37-key layout, from the mapping test.
     * Matrix column 0 = inner/thumb keys; columns 1-7 run inner -> outer.
     *   row 0: RC(0,0) inner top key, then 7 number-row keys
     *   row 1: 7 keys (RC(1,0) not populated)
     *   row 2: RC(2,0) thumb key, then 7 home-row keys
     *   row 3: RC(3,0) thumb key, then 7 bottom-row keys
     *   row 4: RC(4,0) + RC(4,3..7) = 6 bottom keys (RC(4,1), RC(4,2) not populated)
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <8>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)
                    RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7)
            RC(4,0)                 RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7)
        >;
    };
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Naya Create Right";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  /* same order as the keymap bindings */
            = <&key_physical_attrs 100 100 0 0 0 0 0>
            , <&key_physical_attrs 100 100 100 0 0 0 0>
            , <&key_physical_attrs 100 100 200 0 0 0 0>
            , <&key_physical_attrs 100 100 300 0 0 0 0>
            , <&key_physical_attrs 100 100 400 0 0 0 0>
            , <&key_physical_attrs 100 100 500 0 0 0 0>
            , <&key_physical_attrs 100 100 600 0 0 0 0>
            , <&key_physical_attrs 100 100 700 0 0 0 0>
            , <&key_physical_attrs 100 100 100 100 0 0 0>
            , <&key_physical_attrs 100 100 200 100 0 0 0>
            , <&key_physical_attrs 100 100 300 100 0 0 0>
            , <&key_physical_attrs 100 100 400 100 0 0 0>
            , <&key_physical_attrs 100 100 500 100 0 0 0>
            , <&key_physical_attrs 100 100 600 100 0 0 0>
            , <&key_physical_attrs 100 100 700 100 0 0 0>
            , <&key_physical_attrs 100 100 200 400 0 0 0>
            , <&key_physical_attrs 100 100 100 200 0 0 0>
            , <&key_physical_attrs 100 100 200 200 0 0 0>
            , <&key_physical_attrs 100 100 300 200 0 0 0>
            , <&key_physical_attrs 100 100 400 200 0 0 0>
            , <&key_physical_attrs 100 100 500 200 0 0 0>
            , <&key_physical_attrs 100 100 600 200 0 0 0>
            , <&key_physical_attrs 100 100 700 200 0 0 0>
            , <&key_physical_attrs 100 100 100 400 0 0 0>
            , <&key_physical_attrs 100 100 100 300 0 0 0>
            , <&key_physical_attrs 100 100 200 300 0 0 0>
            , <&key_physical_attrs 100 100 300 300 0 0 0>
            , <&key_physical_attrs 100 100 400 300 0 0 0>
            , <&key_physical_attrs 100 100 500 300 0 0 0>
            , <&key_physical_attrs 100 100 600 300 0 0 0>
            , <&key_physical_attrs 100 100 700 300 0 0 0>
            , <&key_physical_attrs 100 100 0 400 0 0 0>
            , <&key_physical_attrs 100 100 300 400 0 0 0>
            , <&key_physical_attrs 100 100 400 400 0 0 0>
            , <&key_physical_attrs 100 100 500 400 0 0 0>
            , <&key_physical_attrs 100 100 600 400 0 0 0>
            , <&key_physical_attrs 100 100 700 400 0 0 0>
            ;
    };
};

/* The nice!nano board routes these peripherals onto pins the Naya matrix uses
 * (e.g. UART on P0.06/P0.08). Turn them off so nothing fights the matrix. */
&uart0 { status = "disabled"; };
&i2c0  { status = "disabled"; };
&spi1  { status = "disabled"; };
